{
  "dxt_version": "0.2",
  "name": "hubspot-account-info-mcp",
  "version": "0.0.1",
  "description": "The official MCP Server for the Hubspot Account Info API",
  "author": {
    "name": "Hubspot Account Info"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whohags/hubspot-account-info-typescript.git"
  },
  "homepage": "https://github.com/whohags/hubspot-account-info-typescript/tree/main/packages/mcp-server#readme",
  "server": {
    "type": "node",
    "entry_point": "index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/index.js"],
      "env": {
        "HUBSPOT_ACCOUNT_INFO_API_KEY": "${user_config.HUBSPOT_ACCOUNT_INFO_API_KEY}"
      }
    }
  },
  "user_config": {
    "HUBSPOT_ACCOUNT_INFO_API_KEY": {
      "title": "api_key",
      "description": "",
      "required": false,
      "type": "string"
    }
  },
  "tools": [],
  "tools_generated": true,
  "compatibility": {
    "runtimes": {
      "node": ">=18.0.0"
    }
  },
  "keywords": ["api"]
}
